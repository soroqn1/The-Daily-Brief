<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Daily Brief — {{ date_str }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #ffffff;
      color: #111111;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.5;
      padding: 40px 20px;
    }

    .container {
      max-width: 760px;
      margin: 0 auto;
    }

    /* File Bar */
    .file-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #f7f7f8;
      border: 1px solid #e2e2e4;
      border-radius: 6px;
      padding: 8px 12px;
      margin-bottom: 24px;
      font-size: 13px;
    }

    .file-path {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      color: #555555;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      margin-right: 12px;
    }

    .file-actions {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }

    .btn {
      display: inline-block;
      padding: 5px 12px;
      font-size: 12px;
      font-weight: 500;
      color: #111111;
      background-color: #ffffff;
      border: 1px solid #cccccc;
      border-radius: 4px;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }

    .btn:hover {
      background-color: #efefef;
      border-color: #999999;
    }

    .btn-primary {
      background-color: #111111;
      color: #ffffff;
      border-color: #111111;
    }

    .btn-primary:hover {
      background-color: #333333;
      border-color: #333333;
    }

    /* Masthead */
    .masthead {
      margin-bottom: 24px;
      padding-bottom: 12px;
      border-bottom: 3px double #111111;
    }

    .masthead-bar {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 12px;
    }

    .masthead-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(32px, 5vw, 44px);
      font-weight: 900;
      letter-spacing: -0.5px;
      text-transform: uppercase;
      line-height: 1.1;
    }

    .masthead-meta {
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 500;
      color: #333333;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }

    /* Lead Story */
    .lead-story {
      padding: 16px 0 24px;
      border-bottom: 1px solid #111111;
      margin-bottom: 32px;
    }

    .lead-headline {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(22px, 3.5vw, 30px);
      font-weight: 700;
      line-height: 1.25;
      margin-bottom: 10px;
    }

    .ai-recommendation {
      font-family: 'Inter', sans-serif;
      font-size: 15px;
      font-style: italic;
      color: #333333;
      line-height: 1.5;
    }

    /* Sections: Single Scrollable Column */
    .brief-sections {
      display: flex;
      flex-direction: column;
      gap: 36px;
    }

    .brief-section {
      width: 100%;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 2px solid #111111;
      padding-bottom: 6px;
      margin-bottom: 14px;
    }

    .section-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 18px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .section-count {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      font-weight: 600;
      color: #666666;
    }

    /* Item List */
    .item-list {
      list-style: none;
    }

    .item-card {
      padding: 12px 0;
      border-bottom: 1px solid #eaeaea;
    }

    .item-card:last-child {
      border-bottom: none;
    }

    .item-header {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 4px;
    }

    .urgent-badge {
      background-color: #c92a2a;
      color: #ffffff;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      padding: 2px 6px;
      letter-spacing: 0.8px;
      border-radius: 2px;
      line-height: 1.2;
    }

    .item-time {
      font-size: 13px;
      font-weight: 600;
      color: #111111;
      font-variant-numeric: tabular-nums;
    }

    .source-tag {
      font-size: 12px;
      font-weight: 500;
      color: #666666;
      letter-spacing: 0.2px;
    }

    .item-title {
      font-size: 14px;
      font-weight: 600;
      color: #111111;
      line-height: 1.4;
    }

    .item-title a {
      color: #111111;
      text-decoration: none;
      border-bottom: 1px dotted #111111;
    }

    .item-title a:hover {
      border-bottom-style: solid;
    }

    .item-summary {
      font-size: 13px;
      color: #444444;
      line-height: 1.45;
      margin-top: 4px;
    }

    .item-link {
      margin-top: 6px;
      font-size: 12px;
    }

    .item-link a {
      color: #111111;
      text-decoration: none;
      border-bottom: 1px dotted #666666;
    }

    .item-link a:hover {
      border-bottom-style: solid;
    }

    .empty-state {
      font-size: 13px;
      color: #666666;
      padding: 10px 0;
    }

    /* Footer */
    footer {
      margin-top: 48px;
      padding-top: 16px;
      border-top: 1px solid #111111;
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: #666666;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
  </style>
</head>
<body>
  {% macro source_badge(source) %}
    {% if source %}
      {% set clean = source.replace('gmail_work', 'gmail · work').strip('[]') %}
      <span class="source-tag">[{{ clean }}]</span>
    {% endif %}
  {% endmacro %}

  {% macro render_item(item, is_schedule=false) %}
    <li class="item-card">
      <div class="item-header">
        {% if item.urgent or item.priority == 1 %}
        <span class="urgent-badge">Urgent</span>
        {% endif %}
        {% if is_schedule and item.time %}
        <span class="item-time">{{ item.time }}</span>
        {% endif %}
        {{ source_badge(item.source) }}
        <span class="item-title">
          {% if item.url %}
          <a href="{{ item.url }}">{{ item.title }}</a>
          {% else %}
          {{ item.title }}
          {% endif %}
        </span>
      </div>
      {% if item.summary %}
      <p class="item-summary">{{ item.summary }}</p>
      {% endif %}
      {% if item.url %}
      <div class="item-link">
        <a href="{{ item.url }}">→ Open link</a>
      </div>
      {% endif %}
    </li>
  {% endmacro %}

  <div class="container">
    {% if file_path %}
    <div class="file-bar">
      <span class="file-path" title="{{ file_path }}">📄 {{ file_path }}</span>
      <div class="file-actions">
        <button class="btn btn-primary" onclick="copyPath('{{ file_path }}')">Copy Path for AI</button>
        <a href="?force=true" class="btn">Regenerate</a>
      </div>
    </div>
    {% endif %}

    <header class="masthead">
      <div class="masthead-bar">
        <h1 class="masthead-title">The Daily Brief</h1>
        <div class="masthead-meta">{{ date_str }} · {{ issue_number }}</div>
      </div>
    </header>

    {% if warnings %}
    <div style="background: #fef2f2; border: 1px solid #fecaca; border-left: 4px solid #dc2626; border-radius: 6px; padding: 12px 16px; margin-bottom: 24px;">
      <strong style="color: #991b1b; font-size: 13px; display: block; margin-bottom: 4px;">⚠️ Connection Warnings:</strong>
      <ul style="margin-left: 18px; color: #7f1d1d; font-size: 12px; line-height: 1.5;">
        {% for w in warnings %}
        <li>{{ w }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if brief.headline or brief.ai_recommendation %}
    <section class="lead-story">
      {% if brief.headline %}
      <h2 class="lead-headline">"{{ brief.headline.strip('\"') }}"</h2>
      {% endif %}
      {% if brief.ai_recommendation %}
      <p class="ai-recommendation">{{ brief.ai_recommendation }}</p>
      {% endif %}
    </section>
    {% endif %}

    <main class="brief-sections">
      <!-- 1. Action Required -->
      <section class="brief-section">
        <header class="section-header">
          <h2 class="section-title">Action Required</h2>
          {% if brief.action_required %}
          <span class="section-count">{{ brief.action_required | length }}</span>
          {% endif %}
        </header>
        {% if brief.action_required %}
        <ul class="item-list">
          {% for item in brief.action_required %}
          {{ render_item(item) }}
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">All clear ✓</p>
        {% endif %}
      </section>

      <!-- 2. Missed Overnight -->
      <section class="brief-section">
        <header class="section-header">
          <h2 class="section-title">Missed Overnight</h2>
          {% if brief.missed %}
          <span class="section-count">{{ brief.missed | length }}</span>
          {% endif %}
        </header>
        {% if brief.missed %}
        <ul class="item-list">
          {% for item in brief.missed %}
          {{ render_item(item) }}
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">All clear ✓</p>
        {% endif %}
      </section>

      <!-- 3. Today's Schedule -->
      <section class="brief-section">
        <header class="section-header">
          <h2 class="section-title">Today's Schedule</h2>
          {% if brief.schedule %}
          <span class="section-count">{{ brief.schedule | length }}</span>
          {% endif %}
        </header>
        {% if brief.schedule %}
        <ul class="item-list">
          {% for item in brief.schedule %}
          {{ render_item(item, is_schedule=true) }}
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">All clear ✓</p>
        {% endif %}
      </section>

      <!-- 4. Tasks & Goals -->
      <section class="brief-section">
        <header class="section-header">
          <h2 class="section-title">Tasks & Goals</h2>
          {% if brief.tasks %}
          <span class="section-count">{{ brief.tasks | length }}</span>
          {% endif %}
        </header>
        {% if brief.tasks %}
        <ul class="item-list">
          {% for item in brief.tasks %}
          {{ render_item(item) }}
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">All clear ✓</p>
        {% endif %}
      </section>
    </main>

    <footer>
      <span>The Daily Brief • Local Mac Edition</span>
      <span>Automated morning rollup • 7-day local archive</span>
    </footer>
  </div>

  <script>
    function copyPath(text) {
      navigator.clipboard.writeText(text).then(function() {
        var btn = event.target;
        var old = btn.innerText;
        btn.innerText = 'Copied!';
        setTimeout(function() { btn.innerText = old; }, 2000);
      });
    }
  </script>
</body>
</html>
