<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Email Audit — {{ space_name|capitalize }} — {{ date_str }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #ffffff;
      color: #111111;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.5;
      padding: 40px 20px;
    }

    .container {
      max-width: 760px;
      margin: 0 auto;
    }

    /* File Bar */
    .file-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #f7f7f8;
      border: 1px solid #e2e2e4;
      border-radius: 6px;
      padding: 8px 12px;
      margin-bottom: 24px;
      font-size: 13px;
    }

    .file-path {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      color: #555555;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      margin-right: 12px;
    }

    .file-actions {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }

    .btn {
      display: inline-block;
      padding: 5px 12px;
      font-size: 12px;
      font-weight: 500;
      color: #111111;
      background-color: #ffffff;
      border: 1px solid #cccccc;
      border-radius: 4px;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }

    .btn:hover {
      background-color: #efefef;
      border-color: #999999;
    }

    .btn-primary {
      background-color: #111111;
      color: #ffffff;
      border-color: #111111;
    }

    .btn-primary:hover {
      background-color: #333333;
      border-color: #333333;
    }

    /* Masthead */
    .masthead {
      margin-bottom: 24px;
      padding-bottom: 12px;
      border-bottom: 3px double #111111;
    }

    .masthead-bar {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 12px;
    }

    .masthead-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(30px, 5vw, 42px);
      font-weight: 900;
      letter-spacing: -0.5px;
      text-transform: uppercase;
      line-height: 1.1;
    }

    .masthead-meta {
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 500;
      color: #333333;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }

    /* Lead Story */
    .lead-story {
      padding: 16px 0 24px;
      border-bottom: 1px solid #111111;
      margin-bottom: 32px;
    }

    .lead-headline {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(22px, 3.5vw, 28px);
      font-weight: 700;
      line-height: 1.25;
      margin-bottom: 12px;
      letter-spacing: -0.3px;
    }

    .lead-summary {
      font-size: 15px;
      color: #333333;
      line-height: 1.6;
    }

    /* Section Styles */
    .section {
      margin-bottom: 32px;
    }

    .section-title {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #666666;
      padding-bottom: 8px;
      border-bottom: 1px solid #e0e0e0;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .badge-urgent {
      background-color: #c92a2a;
      color: #ffffff;
      font-size: 10px;
      font-weight: 600;
      padding: 2px 6px;
      border-radius: 3px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .item-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .item-card {
      padding: 12px 14px;
      border-left: 3px solid #111111;
      background-color: #fafafa;
      border-radius: 0 4px 4px 0;
    }

    .item-card.urgent {
      border-left-color: #c92a2a;
      background-color: #fff9f9;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 4px;
    }

    .item-title {
      font-size: 14px;
      font-weight: 600;
      color: #111111;
    }

    .item-title a {
      color: inherit;
      text-decoration: none;
    }

    .item-title a:hover {
      text-decoration: underline;
    }

    .item-sender {
      font-size: 12px;
      color: #666666;
      margin-bottom: 4px;
    }

    .item-summary {
      font-size: 13px;
      color: #444444;
      line-height: 1.5;
    }

    .item-date {
      font-size: 11px;
      color: #888888;
      margin-top: 4px;
    }

    .checklist {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .checklist-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: #222222;
      padding: 6px 0;
    }

    .checklist-item input[type="checkbox"] {
      margin-top: 3px;
      cursor: pointer;
    }

    .empty-state {
      font-size: 13px;
      color: #888888;
      font-style: italic;
    }

    footer {
      margin-top: 48px;
      padding-top: 16px;
      border-top: 1px solid #e0e0e0;
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: #888888;
    }
  </style>
</head>
<body>
  <div class="container">
    {% if file_path %}
    <div class="file-bar">
      <span class="file-path" title="{{ file_path }}">📄 {{ file_path }}</span>
      <div class="file-actions">
        <button class="btn btn-primary" onclick="copyPath('{{ file_path }}')">Copy Path for AI</button>
        <a href="?force=true" class="btn">Regenerate</a>
      </div>
    </div>
    {% endif %}

    <header class="masthead">
      <div class="masthead-bar">
        <h1 class="masthead-title">Email Audit</h1>
        <div class="masthead-meta">
          <span>Space: {{ space_name|upper }}</span> • <span>{{ date_str }}</span>
        </div>
      </div>
    </header>

    <div class="lead-story">
      <h2 class="lead-headline">{{ audit.headline or "Inbox Status Report" }}</h2>
      <p class="lead-summary">{{ audit.summary or "Review of pending email communications and required follow-ups." }}</p>
    </div>

    <main>
      <!-- Needs Reply -->
      <section class="section">
        <h3 class="section-title">
          <span>⚡ Needs Reply / Action</span>
        </h3>
        {% if audit.needs_reply %}
        <ul class="item-list">
          {% for item in audit.needs_reply %}
          <li class="item-card {% if item.urgent %}urgent{% endif %}">
            <div class="item-header">
              <div class="item-title">
                {% if item.url %}
                <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
                {% else %}
                {{ item.title }}
                {% endif %}
              </div>
              {% if item.urgent %}
              <span class="badge-urgent">Urgent</span>
              {% endif %}
            </div>
            {% if item.sender %}
            <div class="item-sender">From: {{ item.sender }}</div>
            {% endif %}
            <div class="item-summary">{{ item.summary }}</div>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">No emails currently awaiting your reply ✓</p>
        {% endif %}
      </section>

      <!-- Commitments & In Flight -->
      <section class="section">
        <h3 class="section-title">
          <span>⏳ Commitments & In-Flight Agreements</span>
        </h3>
        {% if audit.commitments_and_pending %}
        <ul class="item-list">
          {% for item in audit.commitments_and_pending %}
          <li class="item-card">
            <div class="item-header">
              <div class="item-title">
                {% if item.url %}
                <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
                {% else %}
                {{ item.title }}
                {% endif %}
              </div>
            </div>
            <div class="item-summary">{{ item.summary }}</div>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">No pending commitments recorded ✓</p>
        {% endif %}
      </section>

      <!-- Deadlines & Urgent -->
      <section class="section">
        <h3 class="section-title">
          <span>📅 Deadlines & Urgent Notices</span>
        </h3>
        {% if audit.deadlines_and_urgent %}
        <ul class="item-list">
          {% for item in audit.deadlines_and_urgent %}
          <li class="item-card urgent">
            <div class="item-header">
              <div class="item-title">
                {% if item.url %}
                <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
                {% else %}
                {{ item.title }}
                {% endif %}
              </div>
            </div>
            <div class="item-summary">{{ item.summary }}</div>
            {% if item.date %}
            <div class="item-date">Deadline / Date: {{ item.date }}</div>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">No upcoming deadlines or urgent notices found ✓</p>
        {% endif %}
      </section>

      <!-- Action Checklist -->
      <section class="section">
        <h3 class="section-title">
          <span>✅ What To Finish / Action Checklist</span>
        </h3>
        {% if audit.checklist %}
        <ul class="checklist">
          {% for task in audit.checklist %}
          <li class="checklist-item">
            <input type="checkbox" id="task-{{ loop.index }}">
            <label for="task-{{ loop.index }}">{{ task }}</label>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">All actions completed ✓</p>
        {% endif %}
      </section>
    </main>

    <footer>
      <span>The Daily Brief • Email Audit</span>
      <span>Space: {{ space_name }} • Local Report</span>
    </footer>
  </div>

  <script>
    function copyPath(text) {
      navigator.clipboard.writeText(text).then(function() {
        var btn = event.target;
        var old = btn.innerText;
        btn.innerText = 'Copied!';
        setTimeout(function() { btn.innerText = old; }, 2000);
      });
    }
  </script>
</body>
</html>
