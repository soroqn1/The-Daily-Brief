<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>The Daily Brief — Local Hub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,600&family=Inter:wght@400;500;600;700&display=swap">
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('the_daily_brief_theme');
        var prefersDark = window.matchMedia &&
                          window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>
  <style>
    :root {
      --background: #f7f4ed;
      --paper: #ffffff;
      --paper-sunken: #f1ecdf;
      --foreground: #181614;
      --ink-muted: #6a645d;
      --border: rgba(24, 22, 20, 0.20);
      --border-subtle: rgba(24, 22, 20, 0.12);
      --border-double: rgba(24, 22, 20, 0.35);
      --accent-carmine: #b92b1b;
      --accent-indigo: #1b2f6b;
      --accent-amber: #b86214;
      --accent-forest: #23693e;
      --ink-shadow: rgba(24, 22, 20, 0.08);
      --status-good: #1a7431;
      --status-good-bg: #eaf6ed;
      --status-good-border: rgba(26, 116, 49, 0.30);
      --live-dot-color: #16a34a;
    }

    html.dark {
      --background: #121315;
      --paper: #1b1d20;
      --paper-sunken: #151619;
      --foreground: #eee9e0;
      --ink-muted: #96938c;
      --border: rgba(238, 233, 224, 0.15);
      --border-subtle: rgba(238, 233, 224, 0.10);
      --border-double: rgba(238, 233, 224, 0.25);
      --accent-carmine: #ff735f;
      --accent-indigo: #6091ff;
      --accent-amber: #fca446;
      --accent-forest: #3dd68c;
      --ink-shadow: rgba(0, 0, 0, 0.50);
      --status-good: #3dd68c;
      --status-good-bg: rgba(61, 214, 140, 0.12);
      --status-good-border: rgba(61, 214, 140, 0.30);
      --live-dot-color: #3dd68c;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--background);
      color: var(--foreground);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      margin: 0;
      line-height: 1.48;
      -webkit-font-smoothing: antialiased;
      transition: background 0.25s ease, color 0.25s ease;
    }
    button, input, select { font: inherit; }

    .editorial-icon {
      width: 14px;
      height: 14px;
      display: inline-block;
      vertical-align: -2px;
      stroke: currentColor;
      flex-shrink: 0;
    }

    /* Animations & Tactile States */
    @keyframes pulseLive {
      0% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.6); }
      70% { transform: scale(1.05); opacity: 1; box-shadow: 0 0 0 5px rgba(22, 163, 74, 0); }
      100% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 0 0 rgba(22, 163, 74, 0); }
    }
    .live-dot {
      width: 6px;
      height: 6px;
      background: var(--live-dot-color);
      border-radius: 50%;
      display: inline-block;
      animation: pulseLive 2.4s infinite ease-in-out;
    }

    @keyframes rotaryRoll {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .btn:hover .icon-rotary {
      animation: rotaryRoll 0.75s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }
    }

    .app-shell {
      min-height: 100vh;
      background: var(--background);
      position: relative;
    }

    /* Outer Newsprint Hairline Frame */
    .app-shell:before {
      content: '';
      position: fixed;
      inset: 6px;
      border: 1px solid var(--border-subtle);
      pointer-events: none;
      z-index: 40;
    }

    .page-wrap {
      max-width: 1118px;
      margin: 0 auto;
      padding: 16px 24px 60px;
      position: relative;
      z-index: 1;
    }

    /* Broadsheet Masthead & Folio Strip */
    .folio-strip {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid var(--border);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    .folio-left, .folio-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .folio-divider { opacity: 0.5; }
    .edition-badge {
      background: var(--paper-sunken);
      border: 1px solid var(--border);
      padding: 2px 8px;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.14em;
      color: var(--foreground);
    }

    /* Theme Switcher in Folio */
    .theme-toggle-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: var(--paper-sunken);
      border: 1px solid var(--border);
      padding: 3px 9px;
      border-radius: 16px;
      cursor: pointer;
      color: var(--foreground);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transition: all 0.2s ease;
    }
    .theme-toggle-btn:hover {
      border-color: var(--foreground);
      background: var(--paper);
    }
    .toggle-track {
      width: 26px;
      height: 14px;
      background: var(--border);
      border-radius: 9px;
      position: relative;
      display: inline-block;
      transition: background 0.2s ease;
    }
    .toggle-thumb {
      width: 10px;
      height: 10px;
      background: var(--foreground);
      color: var(--background);
      border-radius: 50%;
      position: absolute;
      top: 2px;
      left: 2px;
      transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .theme-icon-night { display: none; }
    html.dark .theme-icon-day { display: none; }
    html.dark .theme-icon-night { display: inline-flex; }
    html.dark .toggle-thumb {
      transform: translateX(12px);
      background: var(--accent-carmine);
    }
    html.dark .toggle-track {
      background: rgba(255, 115, 95, 0.35);
    }

    /* Broadsheet Nameplate */
    .masthead-nameplate {
      padding: 24px 0 16px;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 20px;
      border-bottom: 3px double var(--border-double);
    }
    .crest-box {
      width: 52px;
      height: 52px;
      border: 1px solid var(--border-double);
      background: var(--paper-sunken);
      display: grid;
      place-items: center;
      color: var(--foreground);
    }
    .crest-box .crest-icon {
      width: 32px;
      height: 32px;
    }
    .nameplate-center { text-align: center; }
    .nameplate-kicker {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent-carmine);
      margin-bottom: 4px;
    }
    .newspaper-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(34px, 5.5vw, 64px);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 0.95;
      text-transform: uppercase;
      margin: 0;
      color: var(--foreground);
    }
    .newspaper-motto {
      font-family: 'Newsreader', Georgia, serif;
      font-style: italic;
      font-size: 13px;
      color: var(--ink-muted);
      margin-top: 6px;
    }
    .nameplate-actions {
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: flex-end;
    }

    /* Press Status Bar */
    .press-run-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 12px;
      margin-top: 6px;
      background: var(--paper-sunken);
      border: 1px solid var(--border-subtle);
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    .press-run-bar strong {
      color: var(--foreground);
      font-weight: 700;
    }
    .press-run-bar code {
      font-family: monospace;
      background: var(--paper);
      padding: 1px 5px;
      border: 1px solid var(--border-subtle);
      font-size: 9px;
    }

    /* Telegraph Wire Banner (Global Daily Feed) */
    .global-banner {
      background: var(--paper);
      border: 1px solid var(--border);
      box-shadow: 2px 3px 0 var(--ink-shadow);
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 18px;
      margin: 24px 0 28px;
      position: relative;
    }
    .global-banner::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: 4px;
      background: var(--accent-indigo);
    }
    .banner-icon-box {
      width: 44px;
      height: 44px;
      border: 1px solid var(--border);
      background: var(--paper-sunken);
      display: grid;
      place-items: center;
      color: var(--accent-indigo);
      flex-shrink: 0;
    }
    .banner-icon-box .editorial-icon {
      width: 22px;
      height: 22px;
    }
    .banner-copy { flex: 1; }
    .banner-eyebrow {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent-indigo);
      margin-bottom: 3px;
    }
    .banner-headline {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 20px;
      font-weight: 700;
      margin: 0 0 4px;
      color: var(--foreground);
    }
    .banner-deck {
      font-size: 12px;
      color: var(--ink-muted);
      margin: 0;
      line-height: 1.4;
    }
    .banner-actions {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }

    /* Sections & Space Cards (Broadsheet Grid) */
    .section-headline-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 16px 0 10px;
      border-bottom: 2px solid var(--border-double);
      margin-bottom: 20px;
    }
    .section-kicker {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent-carmine);
      display: block;
      margin-bottom: 2px;
    }
    .section-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      margin: 0;
      color: var(--foreground);
    }
    .section-title span {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      font-weight: 600;
      color: var(--ink-muted);
      vertical-align: middle;
    }

    .spaces-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-bottom: 36px;
    }
    .space-card {
      background: var(--paper);
      min-height: 340px;
      padding: 22px;
      border: 1px solid var(--border);
      box-shadow: 2px 3px 0 var(--ink-shadow);
      display: flex;
      flex-direction: column;
      position: relative;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.2s ease;
    }
    .space-card:hover {
      transform: translateY(-2px);
      box-shadow: 4px 6px 0 var(--ink-shadow);
      border-color: var(--foreground);
    }

    .card-accent-bar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
    }
    .card-accent-bar.carmine { background: var(--accent-carmine); }
    .card-accent-bar.indigo { background: var(--accent-indigo); }
    .card-accent-bar.amber { background: var(--accent-amber); }
    .card-accent-bar.forest { background: var(--accent-forest); }

    .space-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }
    .space-title-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .desk-folio {
      font-size: 8px;
      font-weight: 800;
      letter-spacing: 0.15em;
      color: var(--ink-muted);
      text-transform: uppercase;
      display: block;
      margin-bottom: 1px;
    }
    .space-title-row h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin: 0;
      color: var(--foreground);
    }
    .space-count {
      font-size: 8px;
      background: var(--paper-sunken);
      border: 1px solid var(--border-subtle);
      padding: 2px 6px;
      color: var(--ink-muted);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 700;
    }
    .accent-dot {
      width: 8px;
      height: 8px;
      display: inline-block;
    }
    .accent-dot.carmine { background: var(--accent-carmine); }
    .accent-dot.indigo { background: var(--accent-indigo); }
    .accent-dot.amber { background: var(--accent-amber); }
    .accent-dot.forest { background: var(--accent-forest); }

    .space-header-actions {
      display: flex;
      gap: 5px;
      align-items: center;
    }

    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 10px;
    }
    .path {
      color: var(--ink-muted);
      margin: 12px 0 10px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .connector-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      margin-bottom: 14px;
      min-height: 28px;
    }
    .connector {
      border: 1px solid var(--border);
      background: var(--paper-sunken);
      padding: 4px 8px;
      font-size: 9px;
      letter-spacing: 0.08em;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--foreground);
    }
    .connector strong { font-weight: 700; }
    .conn-del-btn {
      border: 0;
      background: none;
      color: var(--ink-muted);
      font-size: 14px;
      line-height: 1;
      cursor: pointer;
      padding: 0 0 0 4px;
      transition: color 0.15s ease;
    }
    .conn-del-btn:hover { color: var(--accent-carmine); }
    .add-source {
      border: 1px dashed var(--border);
      background: transparent;
      color: var(--ink-muted);
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      cursor: pointer;
      font-weight: 600;
      padding: 3px 8px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all 0.15s ease;
    }
    .add-source:hover {
      border-color: var(--foreground);
      color: var(--foreground);
      background: var(--paper-sunken);
    }
    .empty-hint {
      font-family: 'Newsreader', Georgia, serif;
      font-style: italic;
      font-size: 12px;
      color: var(--ink-muted);
    }

    /* Diagnostics Panel */
    .diagnostics-panel {
      border: 1px solid var(--border);
      background: var(--paper-sunken);
      padding: 10px 12px;
      margin: 10px 0 14px;
      font-size: 11px;
      color: var(--foreground);
    }
    .diagnostics-panel.ok {
      border-left: 3px solid var(--status-good);
      background: var(--status-good-bg);
      color: var(--status-good);
    }
    .diagnostics-panel.err {
      border-left: 3px solid var(--accent-carmine);
      background: rgba(185, 43, 27, 0.08);
      color: var(--accent-carmine);
    }
    .diag-item { margin-bottom: 4px; font-size: 11px; }
    .diag-item:last-child { margin-bottom: 0; }
    .diag-ping {
      background: var(--paper);
      border-left: 2px solid var(--accent-indigo);
      padding: 6px 10px;
      font-size: 11px;
      color: var(--foreground);
      font-style: italic;
      margin-top: 6px;
    }

    /* Edition Dispatches Output Box */
    .report-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0 6px;
      border-top: 1px solid var(--border);
      color: var(--ink-muted);
      font-size: 9px;
      letter-spacing: 0.14em;
      font-weight: 700;
      text-transform: uppercase;
    }
    .report-list {
      display: flex;
      flex-direction: column;
      background: var(--paper-sunken);
      border: 1px solid var(--border-subtle);
      margin-bottom: 12px;
    }
    .report-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 12px;
      border-bottom: 1px solid var(--border-subtle);
      gap: 12px;
    }
    .report-row:last-child { border-bottom: 0; }
    .report-heading { display: flex; align-items: center; gap: 8px; }
    .report-kicker {
      font-family: 'Playfair Display', Georgia, serif;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: -0.01em;
      color: var(--foreground);
    }
    .report-time {
      background: var(--paper);
      color: var(--foreground);
      border: 1px solid var(--border);
      padding: 2px 6px;
      font-family: ui-monospace, SFMono-Regular, monospace;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.04em;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .report-time.status-none {
      color: var(--ink-muted);
      border-color: var(--border-subtle);
      background: transparent;
    }

    .report-status {
      font-size: 8px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
      display: block;
      margin-top: 3px;
    }
    .status-good { color: var(--status-good); }
    .status-muted { color: var(--ink-muted); }

    /* Rubber Stamp Seal */
    .stamp-seal {
      font-size: 8px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 1px 4px;
      border: 1px solid var(--status-good);
      color: var(--status-good);
      margin-right: 5px;
      display: inline-block;
      vertical-align: middle;
      line-height: 1.2;
    }
    .stamp-seal.muted {
      border-color: var(--ink-muted);
      color: var(--ink-muted);
    }

    .report-actions { display: flex; gap: 5px; flex-shrink: 0; }

    /* AI Path Copy Button */
    .copy-path {
      background: var(--paper);
      border: 1px dashed var(--border);
      color: var(--ink-muted);
      text-transform: uppercase;
      font-size: 9px;
      letter-spacing: 0.08em;
      padding: 8px 10px;
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.18s ease;
    }
    .copy-path:hover {
      border-color: var(--foreground);
      color: var(--foreground);
      background: var(--paper-sunken);
    }

    /* Blank Frame: Add New Space Card */
    .new-space-card {
      background: transparent;
      border: 2px dashed var(--border);
      min-height: 340px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 10px;
      cursor: pointer;
      color: var(--foreground);
      padding: 24px;
      transition: all 0.2s ease;
    }
    .new-space-card:hover {
      border-color: var(--accent-indigo);
      background: var(--paper-sunken);
      transform: translateY(-2px);
    }
    .new-space-icon-box {
      width: 44px;
      height: 44px;
      border: 1px solid var(--foreground);
      display: grid;
      place-items: center;
      margin-bottom: 4px;
    }
    .new-space-card strong {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .new-space-card small {
      color: var(--ink-muted);
      font-size: 12px;
      font-family: 'Newsreader', Georgia, serif;
      font-style: italic;
    }

    /* Colophon / Footer Imprint */
    .footer-colophon {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 24px;
      border-top: 3px double var(--border-double);
      color: var(--ink-muted);
      font-size: 11px;
    }
    .footer-colophon > div:first-child {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .colophon-crest {
      width: 30px;
      height: 30px;
      border: 1px solid var(--border);
      display: grid;
      place-items: center;
      color: var(--foreground);
    }
    .footer-colophon span.label {
      font-weight: 700;
      letter-spacing: 0.12em;
      color: var(--foreground);
      font-size: 9px;
      text-transform: uppercase;
    }
    .footer-colophon p { margin: 2px 0 0; }
    .footer-colophon code {
      font-family: monospace;
      background: var(--paper-sunken);
      padding: 1px 4px;
    }
    .engine-tag {
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 700;
    }
    .engine-tag span {
      border: 1px solid var(--border);
      background: var(--paper);
      padding: 2px 6px;
    }

    /* Button Styles */
    .btn {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 6px 12px;
      border-radius: 0;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      line-height: 1.2;
      font-weight: 600;
      border: 1px solid transparent;
      transition: transform 0.12s ease, background 0.15s ease,
                  border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .btn:active {
      transform: translateY(1px);
    }
    .btn-primary {
      background: var(--foreground);
      color: var(--background);
      border-color: var(--foreground);
    }
    .btn-primary:hover {
      background: var(--accent-carmine);
      border-color: var(--accent-carmine);
      color: #ffffff;
    }
    .btn-outline {
      background: var(--paper);
      color: var(--foreground);
      border-color: var(--border);
    }
    .btn-outline:hover {
      background: var(--paper-sunken);
      border-color: var(--foreground);
    }
    .btn-ghost {
      background: transparent;
      color: var(--ink-muted);
      border-color: transparent;
    }
    .btn-ghost:hover {
      background: var(--paper-sunken);
      color: var(--foreground);
    }
    .btn-sm { padding: 4px 8px; font-size: 9px; }
    .btn-icon { padding: 4px 6px; }

    /* Editorial Modals */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(18, 19, 21, 0.45);
      z-index: 100;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(3px);
    }
    .modal-overlay.active { display: flex; }
    .modal-box {
      background: var(--paper);
      border: 1px solid var(--foreground);
      box-shadow: 6px 6px 0 var(--ink-shadow);
      border-radius: 0;
      width: 100%;
      max-width: 540px;
      padding: 26px;
      color: var(--foreground);
      max-height: 90vh;
      overflow-y: auto;
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      border-bottom: 2px solid var(--border);
      padding-bottom: 10px;
    }
    .modal-header h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 24px;
      font-weight: 700;
      margin: 0;
      color: var(--foreground);
    }
    .modal-close {
      background: none;
      border: none;
      font-size: 22px;
      cursor: pointer;
      color: var(--ink-muted);
      line-height: 1;
    }
    .modal-close:hover { color: var(--foreground); }
    .form-group { margin-bottom: 14px; }
    .form-group label {
      display: block;
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 4px;
      color: var(--ink-muted);
    }
    .form-control {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid var(--border);
      border-radius: 0;
      font-size: 13px;
      font-family: inherit;
      background: var(--paper-sunken);
      color: var(--foreground);
    }
    .form-control:focus {
      outline: 1px solid var(--accent-indigo);
      border-color: var(--accent-indigo);
      background: var(--paper);
    }
    .guide-box {
      background: var(--paper-sunken);
      border: 1px solid var(--border-subtle);
      border-left: 3px solid var(--accent-indigo);
      padding: 12px;
      margin-bottom: 14px;
      font-size: 12px;
      line-height: 1.5;
      color: var(--foreground);
    }
    .guide-box ol { margin-left: 18px; margin-top: 6px; }
    .guide-box li { margin-bottom: 4px; }
    .guide-link {
      display: inline-block;
      margin-top: 8px;
      color: var(--accent-indigo);
      text-decoration: none;
      font-weight: 600;
    }
    .guide-link:hover { text-decoration: underline; }
    .env-badge-box {
      background: var(--paper-sunken);
      border: 1px solid var(--border-subtle);
      border-radius: 0;
      padding: 8px 12px;
      margin-bottom: 14px;
      font-size: 11px;
      color: var(--foreground);
    }
    .env-badge-box code {
      background: var(--paper);
      border: 1px solid var(--border-subtle);
      padding: 2px 6px;
      font-family: monospace;
      font-weight: 700;
    }
    .oauth-btn {
      width: 100%;
      margin-top: 8px;
      padding: 10px;
      background: var(--paper);
      border: 1px solid var(--accent-indigo);
      color: var(--accent-indigo);
      font-family: 'Inter', sans-serif;
      font-weight: 700;
      cursor: pointer;
      border-radius: 0;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.15s ease;
    }
    .oauth-btn:hover {
      background: var(--accent-indigo);
      color: #ffffff;
    }
    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 20px;
      border-top: 1px solid var(--border-subtle);
      padding-top: 14px;
    }

    @media (max-width: 920px) {
      .page-wrap { padding: 12px 16px 50px; }
      .masthead-nameplate {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 12px;
      }
      .crest-box { margin: 0 auto; }
      .nameplate-actions {
        flex-direction: row;
        justify-content: center;
        width: 100%;
      }
      .spaces-grid { grid-template-columns: 1fr; }
      .global-banner { flex-wrap: wrap; }
      .banner-actions { width: 100%; justify-content: flex-start; }
      .press-run-bar { flex-wrap: wrap; gap: 6px; }
      .folio-strip { flex-wrap: wrap; gap: 8px; }
    }
  </style>
</head>
<body>
  <main class="app-shell">
    <div class="page-wrap">
      <!-- Folio Top Bar -->
      <header class="folio-strip">
        <div class="folio-left">
          <span>VOL. I</span>
          <span class="folio-divider">·</span>
          <span>NO. 24</span>
          <span class="folio-divider">·</span>
          <span>LOCAL INTELLIGENCE ARCHIVE</span>
        </div>
        <div class="folio-center">
          <span class="edition-badge">MACBOOK PRIVATE BROADSHEET</span>
        </div>
        <div class="folio-right">
          <span>{{ today_formatted }}</span>
          <button type="button" class="theme-toggle-btn" id="themeToggleBtn"
                  onclick="toggleTheme()" aria-label="Toggle Night Edition">
            <span class="toggle-track">
              <span class="toggle-thumb">
                {{ svg.sun | safe }}
                {{ svg.moon | safe }}
              </span>
            </span>
            <span id="themeLabelText">NIGHT EDITION</span>
          </button>
        </div>
      </header>

      <!-- Broadsheet Masthead Nameplate -->
      <section class="masthead-nameplate">
        <div class="crest-box">
          {{ svg.press_crest | safe }}
        </div>
        <div class="nameplate-center">
          <div class="nameplate-kicker">LOCAL-FIRST INTELLIGENCE DISPATCH</div>
          <h1 class="newspaper-title">The Daily Brief</h1>
          <p class="newspaper-motto">
            "All the signal fit to compute — synthesized on MacBook wake."
          </p>
        </div>
        <div class="nameplate-actions">
          <a href="/global/daily" class="btn btn-outline btn-sm" target="_blank">
            {{ svg.telegraph | safe }} Global feed
          </a>
          <button type="button" class="btn btn-primary btn-sm" onclick="openAddSpaceModal()">
            {{ svg.plus | safe }} New space
          </button>
          <button type="button" class="btn btn-outline btn-sm" onclick="openAddConnectModal()">
            {{ svg.quill | safe }} Add connect
          </button>
        </div>
      </section>

      <!-- Press Status Bar -->
      <section class="press-run-bar">
        <div>
          <span class="live-dot"></span>
          <strong>LOCAL ENGINE:</strong> ACTIVE FASTAPI v0.2
        </div>
        <div>
          <strong>STORAGE:</strong> <code>{{ config.storage_dir }}</code>
        </div>
        <div>
          <strong>DESKS:</strong> {{ cards | length }} SPACES CONFIGURED
        </div>
        <div>
          <strong>DISPATCH:</strong> ON DEMAND
        </div>
      </section>

      <!-- Telegraph Wire Banner (Global Daily Feed) -->
      <section class="global-banner">
        <div class="banner-icon-box">
          {{ svg.telegraph | safe }}
        </div>
        <div class="banner-copy">
          <div class="banner-eyebrow">THE TELEGRAPH WIRE · UNIFIED DISPATCH</div>
          <h2 class="banner-headline">Cross-Space Morning Briefing</h2>
          <p class="banner-deck">
            Consolidated intelligence summary across all active desks, urgent actions,
            and correspondence files.
          </p>
        </div>
        <div class="banner-actions">
          <a href="/global/daily" class="btn btn-primary btn-sm" target="_blank">
            {{ svg.open | safe }} Open Global Feed
          </a>
          <a href="/global/daily?force=true" class="btn btn-outline btn-sm">
            {{ svg.rotary | safe }} Regenerate All
          </a>
          <a href="/global/daily/raw" class="btn btn-ghost btn-sm" target="_blank">
            Raw .md
          </a>
        </div>
      </section>

      <!-- Intelligence Desks Section -->
      <div class="section-headline-bar">
        <div>
          <span class="section-kicker">INTELLIGENCE DESKS</span>
          <h2 class="section-title">Spaces <span>({{ cards | length }})</span></h2>
        </div>
        <button type="button" class="btn btn-outline btn-sm" onclick="openAddSpaceModal()">
          {{ svg.plus | safe }} New Space
        </button>
      </div>

      <section class="spaces-grid">
        {% for card in cards %}
        <article class="space-card" id="space-card-{{ card.name }}">
          <div class="card-accent-bar {{ card.accent_color }}"></div>
          <div class="space-card-head">
            <div class="space-title-row">
              <span class="accent-dot {{ card.accent_color }}"></span>
              <div>
                <span class="desk-folio">DESK SEC. {{ card.desk_num }}</span>
                <h3>Space: {{ card.name | upper }}</h3>
              </div>
              <span class="space-count">{{ card.source_count_str }}</span>
            </div>
            <div class="space-header-actions">
              <button type="button" class="btn btn-outline btn-sm"
                      onclick="runDiagnostics('{{ card.name }}')" title="Test connections and model">
                {{ svg.spark | safe }} Test
              </button>
              <button type="button" class="btn btn-outline btn-sm"
                      onclick="openAddConnectModal('{{ card.name }}')" title="Connect a new source">
                {{ svg.quill | safe }} Connect
              </button>
              <button type="button" class="btn btn-ghost btn-sm btn-icon"
                      onclick="deleteSpace('{{ card.name }}')"
                      title="Delete Space">
                {{ svg.trash | safe }}
              </button>
            </div>
          </div>

          <p class="mono path" title="{{ card.dir }}">
            {{ svg.vault | safe }} {{ card.dir }}
          </p>

          <div class="connector-row">
            {% if card.connectors %}
              {% for c in card.connectors %}
                <span class="connector">
                  <strong>{{ c.type | upper }}</strong> {{ c.name }}{% if c.details_str %} ({{ c.details_str }}){% endif %}
                  <button type="button" class="conn-del-btn"
                          onclick="deleteConnector('{{ card.name }}', '{{ c.id }}')"
                          title="Remove connector">×</button>
                </span>
              {% endfor %}
            {% else %}
              <span class="empty-hint">No dispatch sources connected yet.</span>
            {% endif %}
            <button type="button" class="add-source"
                    onclick="openAddConnectModal('{{ card.name }}')">
              {{ svg.plus | safe }} Add connect
            </button>
          </div>

          <div id="diagnostics-box-{{ card.name }}" class="diagnostics-panel" style="display:none;">
          </div>

          <div class="report-label">
            <span>EDITION DISPATCHES</span>
            <span>2 FILES PUBLISHED</span>
          </div>

          <div class="report-list">
            <div class="report-row">
              <div>
                <div class="report-heading">
                  <span class="report-kicker">Daily brief</span>
                  {% if card.daily_time %}
                    <span class="report-time status-good"><span class="live-dot"></span>{{ card.daily_time }}</span>
                  {% else %}
                    <span class="report-time status-none">—</span>
                  {% endif %}
                </div>
                {% if card.daily_has_file %}
                  <span class="report-status status-good"><span class="stamp-seal">DISPATCH READY</span>GENERATED ✓</span>
                {% else %}
                  <span class="report-status status-muted"><span class="stamp-seal muted">UNFILED</span>NOT GENERATED</span>
                {% endif %}
              </div>
              <div class="report-actions">
                <a href="/{{ card.name }}/daily" class="btn btn-primary btn-sm">
                  {{ svg.open | safe }} Open ↗
                </a>
                <a href="/{{ card.name }}/daily?force=true" class="btn btn-outline btn-sm">
                  {{ svg.rotary | safe }} Regenerate
                </a>
                <a href="/{{ card.name }}/daily/raw" class="btn btn-ghost btn-sm">Raw .md</a>
              </div>
            </div>
            <div class="report-row">
              <div>
                <div class="report-heading">
                  <span class="report-kicker">Email audit</span>
                  {% if card.email_time %}
                    <span class="report-time status-good"><span class="live-dot"></span>{{ card.email_time }}</span>
                  {% else %}
                    <span class="report-time status-none">—</span>
                  {% endif %}
                </div>
                {% if card.email_has_file %}
                  <span class="report-status status-good"><span class="stamp-seal">DISPATCH READY</span>GENERATED ✓</span>
                {% else %}
                  <span class="report-status status-muted"><span class="stamp-seal muted">UNFILED</span>NOT GENERATED</span>
                {% endif %}
              </div>
              <div class="report-actions">
                <a href="/{{ card.name }}/email" class="btn btn-primary btn-sm">
                  {{ svg.open | safe }} Open ↗
                </a>
                <a href="/{{ card.name }}/email?force=true" class="btn btn-outline btn-sm">
                  {{ svg.rotary | safe }} Regenerate
                </a>
                <a href="/{{ card.name }}/email/raw" class="btn btn-ghost btn-sm">Raw .md</a>
              </div>
            </div>
          </div>

          <button type="button" class="copy-path"
                  onclick="copyMarkdownPath('{{ card.daily_md_path }}', this)">
            {{ svg.clip | safe }} Copy markdown path for AI
          </button>
        </article>
        {% endfor %}

        <button type="button" class="new-space-card" onclick="openAddSpaceModal()">
          <div class="new-space-icon-box">
            {{ svg.plus | safe }}
          </div>
          <strong>Open a new desk</strong>
          <small>Keep projects, clients, and research strictly isolated.</small>
        </button>
      </section>

      <!-- Colophon / Footer Imprint -->
      <footer class="footer-colophon">
        <div>
          <div class="colophon-crest">
            {{ svg.press_crest | safe }}
          </div>
          <div>
            <span class="label">LOCAL-FIRST GUARANTEE</span>
            <p>
              Briefs and digests are stored directly in <code>{{ config.storage_dir }}</code>
              and remain strictly private.
            </p>
          </div>
        </div>
        <div class="engine-tag">
          <span>FASTAPI</span> Broadsheet Server Engine
        </div>
      </footer>
    </div>
  </main>

  <!-- Add Space Modal -->
  <div id="addSpaceModal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-header">
        <h2>Create New Space</h2>
        <button class="modal-close" onclick="closeModal('addSpaceModal')">×</button>
      </div>
      <form id="addSpaceForm" onsubmit="submitAddSpace(event)">
        <div class="form-group">
          <label for="spaceNameInput">Space Identifier (e.g. work, crypto, study)</label>
          <input type="text" id="spaceNameInput" class="form-control" required
                 placeholder="e.g. personal">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline"
                  onclick="closeModal('addSpaceModal')">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Space</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Connect Modal -->
  <div id="addConnectModal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-header">
        <h2>Add Connected Source</h2>
        <button class="modal-close" onclick="closeModal('addConnectModal')">×</button>
      </div>
      <form id="addConnectForm" onsubmit="submitAddConnector(event)">
        <div class="form-group">
          <label for="connectSpaceSelect">Target Space</label>
          <select id="connectSpaceSelect" class="form-control"
                  onchange="onSpaceOrTypeChange()" required></select>
        </div>

        <div class="form-group">
          <label for="connectTypeSelect">Connector Type</label>
          <select id="connectTypeSelect" class="form-control"
                  onchange="onSpaceOrTypeChange()" required>
          </select>
        </div>

        <div id="guideContainer" class="guide-box"></div>
        <div id="envTargetBadge" class="env-badge-box"></div>

        <div class="form-group">
          <label for="connectNameInput">Label / Name</label>
          <input type="text" id="connectNameInput" class="form-control" required
                 placeholder="e.g. Work Gmail">
        </div>

        <div id="dynamicFieldsContainer"></div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline"
                  onclick="closeModal('addConnectModal')">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Connector</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const CONNECTOR_TYPES = {{ connector_types_json | safe }};
    const AVAILABLE_SPACES = {{ spaces_list_json | safe }};

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('the_daily_brief_theme', isDark ? 'dark' : 'light');
      } catch (e) {}
      updateThemeLabel();
    }

    function updateThemeLabel() {
      const isDark = document.documentElement.classList.contains('dark');
      const label = document.getElementById('themeLabelText');
      if (label) {
        label.textContent = isDark ? 'DAY BROADSHEET' : 'NIGHT EDITION';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      updateThemeLabel();
    });

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    async function copyMarkdownPath(path, btnEl) {
      try {
        await navigator.clipboard.writeText(path);
        const orig = btnEl.innerHTML;
        btnEl.innerHTML = '✓ Path copied to clipboard';
        btnEl.style.color = 'var(--status-good)';
        btnEl.style.borderColor = 'var(--status-good)';
        setTimeout(() => {
          btnEl.innerHTML = orig;
          btnEl.style.color = '';
          btnEl.style.borderColor = '';
        }, 1800);
      } catch (err) {
        prompt('Copy Markdown path:', path);
      }
    }

    function openModal(id) {
      document.getElementById(id).classList.add('active');
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    function openAddSpaceModal() {
      document.getElementById('spaceNameInput').value = '';
      openModal('addSpaceModal');
    }

    function openAddConnectModal(preselectSpace) {
      const spaceSel = document.getElementById('connectSpaceSelect');
      spaceSel.innerHTML = '';
      AVAILABLE_SPACES.forEach(sp => {
        const opt = document.createElement('option');
        opt.value = sp;
        opt.textContent = sp.toUpperCase();
        if (preselectSpace && sp === preselectSpace) opt.selected = true;
        spaceSel.appendChild(opt);
      });

      const typeSel = document.getElementById('connectTypeSelect');
      typeSel.innerHTML = '';
      CONNECTOR_TYPES.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.type_id;
        opt.textContent = t.name;
        typeSel.appendChild(opt);
      });

      onSpaceOrTypeChange();
      openModal('addConnectModal');
    }

    function computeEnvVarName(typeId, space) {
      if (typeId === 'gmail') {
        return space === 'default' ? 'GMAIL_REFRESH_TOKEN' :
               `GMAIL_REFRESH_TOKEN_${space.toUpperCase().replace(/-/g, '_')}`;
      }
      return `${typeId.toUpperCase()}_TOKEN_${space.toUpperCase().replace(/-/g, '_')}`;
    }

    function onSpaceOrTypeChange() {
      const space = document.getElementById('connectSpaceSelect').value || 'default';
      const typeId = document.getElementById('connectTypeSelect').value;
      const typeInfo = CONNECTOR_TYPES.find(t => t.type_id === typeId);
      if (!typeInfo) return;

      // Update env target badge
      const envBadge = document.getElementById('envTargetBadge');
      if (typeId === 'gmail') {
        const envVar = computeEnvVarName(typeId, space);
        envBadge.style.display = 'block';
        envBadge.innerHTML = `🔑 Auto-saved to <code>.env</code> as: <code>${envVar}</code>`;
      } else {
        envBadge.style.display = 'none';
      }

      // Render Guide
      const guideBox = document.getElementById('guideContainer');
      let stepsHtml = '';
      if (typeInfo.guide_steps && typeInfo.guide_steps.length) {
        stepsHtml = '<ol>' + typeInfo.guide_steps.map(s => `<li>${s}</li>`).join('') + '</ol>';
      }
      let linkHtml = '';
      if (typeInfo.guide_url) {
        linkHtml = `<a href="${typeInfo.guide_url}" target="_blank" class="guide-link">` +
                   `Documentation & Setup Link ↗</a>`;
      }
      guideBox.innerHTML = `<strong>${typeInfo.name} Setup:</strong>` +
        `<p>${typeInfo.description}</p>${stepsHtml}${linkHtml}`;

      // Set default label
      document.getElementById('connectNameInput').value =
        `${space.toUpperCase()} ${typeInfo.name}`;

      // Render dynamic fields
      const fieldsBox = document.getElementById('dynamicFieldsContainer');
      fieldsBox.innerHTML = '';
      (typeInfo.fields || []).forEach(f => {
        const div = document.createElement('div');
        div.className = 'form-group';
        const val = f.default !== undefined ? f.default : '';
        div.innerHTML = `
          <label for="field_${f.name}">${f.label}</label>
          <input type="${f.type || 'text'}" id="field_${f.name}" name="${f.name}"
                 class="form-control" value="${val}" placeholder="${f.placeholder || ''}">
          ${f.name === 'client_secret' ?
            '<div id="secWarning" ' +
            'style="display:none;color:#dc2626;font-size:11px;margin-top:3px;">' +
            '⚠️ Warning: That looks like a Client ID! Starts with GOCSPX-.</div>' : ''}
        `;
        fieldsBox.appendChild(div);

        if (f.name === 'client_secret') {
          setTimeout(() => {
            const inp = document.getElementById('field_client_secret');
            const warn = document.getElementById('secWarning');
            if (inp && warn) {
              const checkVal = () => {
                const isId = inp.value.includes('.apps.googleusercontent.com');
                warn.style.display = isId ? 'block' : 'none';
              };
              inp.addEventListener('input', checkVal);
              checkVal();
            }
          }, 50);
        }

        if (typeId === 'gmail' && f.name === 'refresh_token') {
          const authDiv = document.createElement('div');
          authDiv.innerHTML = `
            <button type="button" class="oauth-btn" onclick="startGoogleOAuth()">
              🔐 Authorize with Google in Browser
            </button>
            <div style="font-size: 11px; color: var(--ink-muted);
                        margin-top: 4px; text-align: center;">
              Logs in via Google and writes token to <code>.env</code> automatically
            </div>
          `;
          fieldsBox.appendChild(authDiv);
        }
      });
    }

    async function runDiagnostics(space) {
      const box = document.getElementById('diagnostics-box-' + space);
      if (!box) return;
      box.style.display = 'block';
      box.className = 'diagnostics-panel';
      box.innerHTML = 'Testing connections... ⏳';

      try {
        const res = await fetch('/api/spaces/' + encodeURIComponent(space) + '/diagnostics');
        const data = await res.json();
        box.className = 'diagnostics-panel ' + (data.all_ok ? 'ok' : 'err');
        let html = '<div style="font-weight:700; margin-bottom:6px; font-size:9px; ' +
                   'text-transform:uppercase; letter-spacing:0.12em; ' +
                   'color:var(--ink-muted);">' +
                   `HEALTH DIAGNOSTICS (${escapeHtml(space.toUpperCase())})</div>`;
        const llmIcon = data.llm.ok ? '✅' : '❌';
        html += `<div class="diag-item">${llmIcon} ` +
                `<strong>LLM (${escapeHtml(data.llm.provider)}):</strong> ` +
                `${escapeHtml(data.llm.message)}</div>`;
        if (data.llm.reply) {
          html += '<div class="diag-ping">' +
                  '💬 Model response to "ping": &ldquo;' +
                  escapeHtml(data.llm.reply) +
                  '&rdquo;</div>';
        }
        if (data.connectors && data.connectors.length) {
          data.connectors.forEach(c => {
            const cIcon = c.ok ? '✅' : '❌';
            html += `<div class="diag-item">${cIcon} ` +
                    `<strong>${escapeHtml(c.type.toUpperCase())}:</strong> ` +
                    `${escapeHtml(c.message)}</div>`;
          });
        } else {
          html += '<div class="diag-item" style="color:var(--ink-muted);">' +
                  'ℹ️ No connectors configured for this space.</div>';
        }
        box.innerHTML = html;
      } catch (err) {
        box.className = 'diagnostics-panel err';
        box.innerHTML = `❌ Failed to run diagnostics: ${err}`;
      }
    }

    async function startGoogleOAuth() {
      const space = document.getElementById('connectSpaceSelect').value;
      const cidEl = document.getElementById('field_client_id');
      const secEl = document.getElementById('field_client_secret');
      const cid = cidEl ? cidEl.value.trim() : '';
      const sec = secEl ? secEl.value.trim() : '';

      if (!cid || !sec) {
        alert('Please enter Client ID and Client Secret before authorizing.');
        return;
      }

      if (sec.includes('.apps.googleusercontent.com')) {
        alert('Error: You entered a Client ID into Client Secret! Must start with GOCSPX-.');
        return;
      }

      try {
        await fetch('/api/auth/gmail/prepare', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ space: space, client_id: cid, client_secret: sec })
        });
      } catch (err) {
        console.error('Failed to prepare credentials:', err);
      }

      const url = '/api/auth/gmail/start?space=' + encodeURIComponent(space);
      window.open(url, 'oauth_window', 'width=600,height=700');
    }

    async function submitAddSpace(e) {
      e.preventDefault();
      const name = document.getElementById('spaceNameInput').value.trim();
      if (!name) return;

      try {
        const res = await fetch('/api/spaces', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name })
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.detail || 'Could not create space'));
        }
      } catch (err) {
        alert('Request failed: ' + err);
      }
    }

    async function deleteSpace(spaceName) {
      if (!confirm(`Are you sure you want to delete space "${spaceName}"?`)) return;
      try {
        const res = await fetch(`/api/spaces/${spaceName}`, { method: 'DELETE' });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.detail || 'Could not delete space'));
        }
      } catch (err) {
        alert('Request failed: ' + err);
      }
    }

    async function submitAddConnector(e) {
      e.preventDefault();
      const space = document.getElementById('connectSpaceSelect').value;
      const typeId = document.getElementById('connectTypeSelect').value;
      const name = document.getElementById('connectNameInput').value;

      const typeInfo = CONNECTOR_TYPES.find(t => t.type_id === typeId);
      const config = {};
      if (typeInfo && typeInfo.fields) {
        typeInfo.fields.forEach(f => {
          const el = document.getElementById(`field_${f.name}`);
          if (el) {
            let val = el.value.trim();
            if (f.type === 'number') val = parseInt(val, 10) || 0;
            config[f.name] = val;
          }
        });
      }

      try {
        const res = await fetch(`/api/spaces/${space}/connectors`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: typeId,
            name: name,
            config: config,
            enabled: true
          })
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.detail || 'Could not add connector'));
        }
      } catch (err) {
        alert('Request failed: ' + err);
      }
    }

    async function deleteConnector(space, connId) {
      if (!confirm(`Remove connector "${connId}"?`)) return;
      try {
        const res = await fetch(`/api/spaces/${space}/connectors/${connId}`, {
          method: 'DELETE'
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.detail || 'Could not remove connector'));
        }
      } catch (err) {
        alert('Request failed: ' + err);
      }
    }

    // Close modal on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModal('addSpaceModal');
        closeModal('addConnectModal');
      }
    });
  </script>
</body>
</html>
